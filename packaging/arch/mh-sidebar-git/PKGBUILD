# Maintainer: midnightheartsgames
# Development package: builds the latest commit of the default branch.
pkgname=mh-sidebar-git
pkgver=0.6.0.r12.gf92ffbd
pkgrel=1
pkgdesc="Sidebar with CPU, GPU, memory, disk and network load (MH Monitoring)"
arch=("x86_64")
url="https://github.com/midnightheartsgames/MH-Sidebar"
license=("MIT" "OFL-1.1")
depends=(
  "gcc-libs"
  "glibc"
  "gtk3"
  "libayatana-appindicator"
  "libglvnd"
  "libxkbcommon"
  "wayland"
  "xdotool"
)
optdepends=(
  "hwdata: AMD and Intel GPU names"
  "kscreen: screen list in KDE Plasma Wayland (kscreen-doctor)"
  "kdialog: settings import/export dialogs in KDE"
  "libdrm: exact AMD GPU model names (amdgpu.ids)"
  "libnotify: alert notifications"
  "nvidia-utils: NVIDIA GPU sensors via NVML"
  "xorg-xrandr: screen list in X11 sessions"
  "zenity: settings import/export dialogs"
)
options=("!lto")
makedepends=("cargo" "git")
provides=("mh-sidebar")
conflicts=("mh-sidebar")
source=("mh-sidebar::git+https://github.com/midnightheartsgames/MH-Sidebar.git")
sha256sums=('SKIP')
_srcdir="mh-sidebar"
_desktop="packaging/arch/mh-sidebar/mh-sidebar.desktop"

pkgver() {
  cd "$_srcdir"
  # Version from Cargo.toml plus commit count and hash: works without tags in the clone.
  printf "%s.r%s.g%s" \
    "$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n1)" \
    "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n "s/host: //p")"
}

build() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --bin MH-Sidebar
}

check() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen
}

package() {
  cd "$_srcdir"
  install -Dm755 target/release/MH-Sidebar "$pkgdir/usr/bin/mh-sidebar"
  install -Dm644 "$_desktop" "$pkgdir/usr/share/applications/mh-sidebar.desktop"
  install -Dm644 assets/mh-sidebar.png "$pkgdir/usr/share/pixmaps/mh-sidebar.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 assets/fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/Cuprum-OFL.txt"
  install -Dm644 THIRD-PARTY.md "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY.md"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
